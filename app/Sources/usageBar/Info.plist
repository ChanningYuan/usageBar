    <string>zh-Hans</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>zh-Hans</string>
        <string>en</string>
    </array>
    <!-- Sparkle 自动更新 -->
    <key>SUFeedURL</key>
    <string>https://raw.githubusercontent.com/ChanningYuan/usageBar/main/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>j+XhxVg+ZDMl63neHl7Wk0vcCdfMInGT4YAlcni9JHQ=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
</dict>
</plist>
